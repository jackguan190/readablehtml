# ReadableHTML — server configuration
# Copy this file to .env.local and fill in the values.

# --- Supabase (required) ---
# Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# --- OpenAI (optional, server-only) ---
# Required ONLY for AI-structured study pages (the "Restructure with AI"
# button on a document). Without it, all documents fall back to heuristic
# structuring — uploads, reading, and annotations still work.
# Never prefix this with NEXT_PUBLIC — it must not be shipped to the browser.
OPENAI_API_KEY=

# --- OCR provider (RESERVED — stub only, not active in alpha) ---
# When the OCR pipeline (lib/documents/ocr.ts) is implemented, set these.
# All scaffolding ships unconfigured; the "Run OCR (beta)" button is
# disabled until ALPHA_LIMITS.ocrJobs is bumped from 0 and a provider key
# is set here. Never prefix any of these with NEXT_PUBLIC.
# OCR_PROVIDER=chandra
# CHANDRA_API_KEY=
# CHANDRA_API_URL=
